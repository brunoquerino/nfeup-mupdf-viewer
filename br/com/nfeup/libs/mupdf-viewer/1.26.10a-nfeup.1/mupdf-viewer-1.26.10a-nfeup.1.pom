  <modelVersion>4.0.0</modelVersion>
  <groupId>br.com.nfeup.libs</groupId>
  <artifactId>mupdf-viewer</artifactId>
  <version>1.26.10a-nfeup.1</version>
  <packaging>aar</packaging>
  <name>NFeUp MuPDF Viewer</name>
  <description>MuPDF Android Viewer com extensoes de renderizacao, texto e codigo de barras usadas pelo NFe Visualizador.</description>
  <url>https://github.com/brunoquerino/nfeup-mupdf-viewer</url>
